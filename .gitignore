# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/

# Tool caches: tests, lint, Quarto, browser automation
.pytest_cache/
.ruff_cache/
.quarto/
.playwright-mcp/

# OS and editor files
.DS_Store
.vscode/
.idea/
*.swp

# osmnx's download cache (the download scripts re-create it)
data/cache/

# Generated by `make`, and rebuilt by the GitHub Action for the website.
# data/raw/ IS committed: it's the OSM and elevation snapshot our edits
# (data/manual/) refer to, and what the Action builds from.
output/
data/processed/
website/_site/
website/trail_map.html
website/routes.geojson
website/labels.geojson

# Personal data, never committed (e.g. GPX of runs that start from someone's home)
data/private/
